#!/bin/bash
# KMS 자격증명 주입 템플릿.
#
# 사용법:
#   1) 이 파일을 .secret 으로 복사:   cp .secret.sample .secret
#   2) 아래 값을 실제 값으로 채운다 (.secret 은 .gitignore 처리되어 커밋되지 않음)
#   3) 구동 전 셸에 로드:             source .secret
#   4) docker compose -f docker-compose-dev.yaml up -d

# ──────────────────────────────────────────────────────────────────────────
# local / stage 테스트 — dev Vault 사용 (BUILD_TYPE=local)
# ──────────────────────────────────────────────────────────────────────────
export DEV_KMS_ENDPOINT=https://dev-vault.example.net:8443
export DEV_KMS_ENGINE=secret
export DEV_KMS_ROLE_ID=<dev-approle-role-id>
export DEV_KMS_ROLE_SECRET=<dev-approle-secret-id>

# ──────────────────────────────────────────────────────────────────────────
# 운영(prod) — BUILD_TYPE=prod 로 띄워야 kmsclient 가 KMS_* 를 읽는다.
#
# [A] Kubernetes auth (클러스터 내부 권장)
#   - ServiceAccount 토큰 파일(/var/run/secrets/kubernetes.io/serviceaccount/token)이
#     존재하면 kmsclient 가 자동으로 Kubernetes auth 를 사용한다 → secret_id 주입 불필요.
#   - 아래 값만 env/ConfigMap 으로 주면 된다 (시크릿 아님):
# export BUILD_TYPE=prod
# export KMS_ENDPOINT=https://vault.example.net:8443
# export KMS_ENGINE=secret
# export KMS_K8S_AUTH_ROLE=<vault-kubernetes-auth-role>
#
# [B] AppRole (SA 토큰 파일이 없는 환경 — 토큰 파일 부재 시 자동 fallback)
# export BUILD_TYPE=prod
# export KMS_ENDPOINT=https://vault.example.net:8443
# export KMS_ENGINE=secret
# export KMS_ROLE_ID=<prod-approle-role-id>
# export KMS_ROLE_SECRET=<prod-approle-secret-id>

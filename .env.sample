
# ======================================================================================
# section 분리자: "__"
# .env.sample에 주석처리된 항목은 기본값이 설정되어 있습니다.
# pydantic_settings 사양에 따라, prefix 에 대한 설정이 하나라도 존재해야 하기 때문에
# prefix 만 있는 dummy 설정을 반드시 정의할 것
#
# 민감 정보(아래 주석에 "KMS-managed"로 표기된 항목)는 KMS(Vault)에서 로드됩니다.
# .env에는 비민감 정보만 둡니다.
# --------------------------------------------------------------------------------------
# ======================================================================================
# [App]
# --------------------------------------------------------------------------------------
APP__=""
# APP__DEBUG=false
# APP__TIMEZONE="UTC"
# KMS-managed: common/api-keys → master_apikey

# =====================================================================
# 운영 환경 설정 (prod, dev, test)
# ---------------------------------------------------------------------
# APP__ENVIRONMENT = "prod"

# ======================================================================================
# [Database]
# portal_db(project) 연결. 별도 읽기 전용 계정이 없어 ixcs-api-service와 동일한
# 일반(쓰기 가능) 계정을 그대로 쓴다 — 이 서비스 코드가 project 테이블에 쓰지
# 않는 것은 DB 권한이 아니라 코드 레벨 약속일 뿐이다.
# --------------------------------------------------------------------------------------
DATABASE__=""
# KMS-managed: common/databases/portal-db → host, port, user, password, database
# KMS-managed(옵션, 계약 push의 할인 정보 조회용): common/databases/billing-db →
# host, port, user, password, database. 없어도 discount는 빈 배열로 폴백한다.

# ======================================================================================
# [Sentry]
# --------------------------------------------------------------------------------------
SENTRY__=""
SENTRY__DSN=""

# ======================================================================================
# [Endpoint]
# metering_api/ism_api는 환경마다 값이 달라 KMS가 아닌 환경변수(호스트 셸 또는
# Helm values env)로 주입한다. .env에도 값을 둘 수 있지만, K8s 운영에서는
# values-*.yaml의 env로 덮어쓰는 것을 기본으로 한다.
# ---------------------------------------------------------------------------------------
ENDPOINT__=""
# 로컬 개발은 dev 클러스터의 metering-api를 외부 주소로 직접 호출한다
# (로컬 컨테이너 네트워크로 연결하지 않음).
# METERING_API_HOST="http(s)://<host>:<port>"
# ISM_API_HOST="http(s)://<host>:<port>/v1"

# ======================================================================================
# [Log]
# --------------------------------------------------------------------------------------
LOG__=""
# LOG__DEFAULT_PATH="./logs"
# LOG__FILENAME="ism_adapter.log"
# LOG__ROTATION="00:00"
# LOG__RETENTION="365 days"
# LOG__COMPRESSION="tar.gz"

# ======================================================================================
# KMS (Vault) — Dev
# 민감정보이므로 .env에 평문으로 두지 말고 구동 시 호스트 셸 환경변수로 주입한다.
#   export DEV_KMS_ENDPOINT=... DEV_KMS_ENGINE=... DEV_KMS_ROLE_ID=... DEV_KMS_ROLE_SECRET=...
# --------------------------------------------------------------------------------------
# DEV_KMS_ENDPOINT=
# DEV_KMS_ENGINE=
# DEV_KMS_ROLE_ID=
# DEV_KMS_ROLE_SECRET=

# ======================================================================================
# KMS (Vault) — Prod/Staging (BUILD_TYPE=prod)
# 클러스터 내부(ServiceAccount 토큰 파일 존재)에서는 Kubernetes auth 를 자동 사용한다.
# 토큰 파일이 없으면 AppRole(KMS_ROLE_ID / KMS_ROLE_SECRET)로 fallback 한다.
# --------------------------------------------------------------------------------------
KMS_ENDPOINT=
KMS_ENGINE=
KMS_K8S_AUTH_ROLE=
KMS_ROLE_ID=
KMS_ROLE_SECRET=
